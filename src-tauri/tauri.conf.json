{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Vox",
    "version": "0.0.8",
    "identifier": "app.vox.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "label": "main",
                "title": "",
                "width": 1100,
                "height": 720,
                "minWidth": 860,
                "minHeight": 560,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "titleBarStyle": "Overlay",
                "transparent": false
            },
            {
                "label": "widget",
                "title": "Vox Widget",
                "url": "widget.html",
                "width": 300,
                "height": 72,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": false,
                "x": -9999,
                "y": -9999
            },
            {
                "label": "enhance",
                "title": "Vox Enhance",
                "url": "enhance.html",
                "width": 36,
                "height": 36,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": false,
                "x": -9999,
                "y": -9999
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "externalBin": [
            "bin/vox-text-enhance",
            "bin/transcribe-cli"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "10.15",
            "signingIdentity": "Developer ID Application: -"
        },
        "windows": {
            "nsis": {
                "displayLanguageSelector": true,
                "installerIcon": "icons/icon.ico"
            }
        },
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0",
                    "libayatana-appindicator3-1",
                    "librsvg2-2",
                    "libasound2"
                ]
            },
            "appimage": {
                "bundleMediaFramework": true
            }
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/imrj05/vox-app/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QjI0RDk5NjIxNzQ3QUIKUldTclJ4ZGltVTJ5SlhwVUpBd29YSjFUQ0ttUFIvUHhSOHFxN1oyTndObnhvSVNLQThuK0J4NzQK"
        }
    }
}
